# Google Sheets (new workbook)
GOOGLE_SHEET_CREDENTIALS=credentials/service_account.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1jjC4oaWsyqLzG6vT5EwJkVAgJCXGpz_7fWr6wb7OU3o/edit
GOOGLE_SHEET_NAME=

# Worksheet names (defaults match the new workbook)
SOURCE_IMPORT_SHEET=Source Import
ACCOUNTS_SHEET=Accounts
QUEUE_SHEET=Publishing Queue
LOG_SHEET=Publishing Log
UPLOAD_GUIDE_SHEET=UPLOAD GUIDE

# Shared Facebook access token (fallback for all accounts)
FB_ACCESS_TOKEN=your_facebook_access_token

# Per-account tokens (credential_property_key values from the Accounts sheet)
# META_TOKEN_FB_ISR=your_token
# META_TOKEN_FB_JPN=your_token
# META_TOKEN_FB_KOR=your_token
# META_TOKEN_FB_RUS=your_token
# META_TOKEN_FB_PH=your_token
# META_TOKEN_FB_JIYA=your_token
# META_TOKEN_FB_MMR=your_token
# META_TOKEN_FB_GLOBAL=your_token
# META_TOKEN_FB_BKK=your_token
# META_TOKEN_FB_TREND=your_token
# META_TOKEN_FB_LTD=your_token
# META_TOKEN_FB_CD=your_token
# META_TOKEN_FB_NFCD=your_token

# YouTube (optional)
# 1. Enable YouTube Data API v3 in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Desktop app) -> download JSON
#    and set YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET (or save the whole
#    JSON as credentials/youtube_client_secret.json)
# 3. Authorize once and set YOUTUBE_OAUTH_REFRESH_TOKEN (headless CI uploads
#    use this; the interactive browser flow is only a local fallback)
# YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_client_secret
# YOUTUBE_OAUTH_REFRESH_TOKEN=your_refresh_token

# LINE Official Account (Messaging API)
# Channel access token from the LINE Developer Console (Messaging API channel).
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# WeChat Official Account (公众号)
# appid + appsecret from the WeChat Official Account platform.
# Per-account credential_property_key can also name an env var like
# META_TOKEN_WECHAT_CD=APPID:SECRET (single value, colons separated).
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret

# Pinterest (API v5)
# Access token from https://developers.pinterest.com/ (OAuth scopes:
# boards:read, pins:read, pins:write). Optional sandbox override.
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5

# Twitch (live broadcast of product videos -> VOD)
# Twitch has no video file upload API, so videos are pushed to the RTMP ingest
# as a short live stream (ffmpeg) which produces a VOD. You need the stream key
# from the Creator Dashboard; the Helix app credentials are optional and only
# used to look up the resulting VOD URL.
# TWITCH_STREAM_KEY=your_twitch_stream_key
# Per-account override: META_TOKEN_TWITCH_CD=your_stream_key
# TWITCH_CLIENT_ID=your_client_id
# TWITCH_CLIENT_SECRET=your_client_secret
# TWITCH_BROADCASTER_ID=your_numeric_user_id
# TWITCH_ACCESS_TOKEN=user_token_with_channel:manage:broadcast (optional, sets title)

# Shopee Open Platform (TH, media hosting only)
# Requires an approved Shopee Open Platform app + Seller Center shop authorized
# to it. Images are hosted via product/upload_img (no generic media-post API).
# Per-account override: META_TOKEN_SHOPEE_CD=your_access_token
# SHOPEE_PARTNER_ID=your_partner_id
# SHOPEE_PARTNER_KEY=your_partner_key
# SHOPEE_ACCESS_TOKEN=your_shop_access_token
# SHOPEE_SHOP_ID=your_shop_id
# SHOPEE_API_BASE=https://partner.shopeemobile.com

# Lazada Open Platform (TH, media hosting only)
# Requires an approved Lazada Open Platform app + Seller Center shop authorized
# to it. Images are migrated via image/migrate (no generic media-post API).
# Per-account override: META_TOKEN_LAZADA_CD=your_access_token
# LAZADA_REGION=th
# LAZADA_APP_KEY=your_app_key
# LAZADA_APP_SECRET=your_app_secret
# LAZADA_ACCESS_TOKEN=your_shop_access_token

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
USE_SECRET_MANAGER=false

# Job retry policy
MAX_JOB_ATTEMPTS=3

# Audio / music handling for Reels and Shorts (optional, default OFF)
# Original sound is always preserved when a video has its own audio track.
# When a video is silent and the following are set, a low-volume approved
# instrumental track is mixed in before upload (requires ffmpeg):
# Silent videos automatically receive rotating real CC0 music from a pinned
# GitHub source (effacestudios/Royalty-Free-Music-Pack).
# Optionally replace/extend it with a directory of approved tracks:
# BACKGROUND_MUSIC_PATH=media/approved_music
# Or a comma-separated list of stable, licensed audio URLs:
# BACKGROUND_MUSIC_URLS=https://example.com/track1.mp3,https://example.com/track2.mp3
# Instagram catalog rotation (optional comma-separated mood searches):
# IG_AUDIO_SEARCH_QUERIES=elegant instrumental,luxury piano,cinematic fashion,soft ambient
