# Google Sheets (new workbook)
GOOGLE_SHEET_CREDENTIALS=credentials/service_account.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1jjC4oaWsyqLzG6vT5EwJkVAgJCXGpz_7fWr6wb7OU3o/edit
GOOGLE_SHEET_NAME=

# Worksheet names (defaults match the new workbook)
SOURCE_IMPORT_SHEET=Source Import
ACCOUNTS_SHEET=Accounts
QUEUE_SHEET=Publishing Queue
LOG_SHEET=Publishing Log
UPLOAD_GUIDE_SHEET=UPLOAD GUIDE

# Shared Facebook access token (fallback for all accounts)
FB_ACCESS_TOKEN=your_facebook_access_token

# Per-account tokens (credential_property_key values from the Accounts sheet)
# META_TOKEN_FB_ISR=your_token
# META_TOKEN_FB_JPN=your_token
# META_TOKEN_FB_KOR=your_token
# META_TOKEN_FB_RUS=your_token
# META_TOKEN_FB_PH=your_token
# META_TOKEN_FB_JIYA=your_token
# META_TOKEN_FB_MMR=your_token
# META_TOKEN_FB_GLOBAL=your_token
# META_TOKEN_FB_BKK=your_token
# META_TOKEN_FB_TREND=your_token
# META_TOKEN_FB_LTD=your_token
# META_TOKEN_FB_CD=your_token
# META_TOKEN_FB_NFCD=your_token

# YouTube (optional)
# 1. Enable YouTube Data API v3 in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Desktop app) -> download JSON
#    and set YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET (or save the whole
#    JSON as credentials/youtube_client_secret.json)
# 3. Authorize once and set YOUTUBE_OAUTH_REFRESH_TOKEN (headless CI uploads
#    use this; the interactive browser flow is only a local fallback)
# YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_client_secret
# YOUTUBE_OAUTH_REFRESH_TOKEN=your_refresh_token

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
USE_SECRET_MANAGER=false

# Job retry policy
MAX_JOB_ATTEMPTS=3

# Audio / music handling for Reels and Shorts (optional, default OFF)
# Original sound is always preserved when a video has its own audio track.
# When a video is silent and the following are set, a low-volume approved
# instrumental track is mixed in before upload (requires ffmpeg):
# MIX_BACKGROUND_MUSIC=true
# BACKGROUND_MUSIC_PATH=media/soft_instrumental.mp3
