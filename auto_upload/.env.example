# Google Sheets
GOOGLE_SHEET_CREDENTIALS=credentials/service_account.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_NAME=AutoUpload
GOOGLE_SHEET_WORKSHEET=Sheet1

# Facebook Access Token (User/Page token - auto-discovers all pages)
FB_ACCESS_TOKEN=your_facebook_access_token

# YouTube (optional)
# 1. Enable YouTube Data API v3 in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Desktop app) -> download JSON
# 3. Save as credentials/youtube_client_secret.json
# On first run, browser will open for authentication

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
USE_SECRET_MANAGER=false
